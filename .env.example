# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Supabase Project URL
# Get from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (Public Key - safe to expose)
# Get from: https://app.supabase.com → Project Settings → API → anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog Analytics (Optional)
# Get from: https://app.posthog.com → Project Settings → Project API Key
# Leave empty to disable analytics tracking
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# IMPORTANT FOR VERCEL DEPLOYMENT:
# Add these same variables to your Vercel project:
# 1. Go to https://vercel.com/dashboard
# 2. Select your project
# 3. Settings → Environment Variables
# 4. Add: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_POSTHOG_API_KEY
# 5. Redeploy
