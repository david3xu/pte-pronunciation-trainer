# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# PostHog Analytics (Optional)
# ============================================
# Get these from your PostHog project:
# https://app.posthog.com/project/settings
VITE_POSTHOG_API_KEY=phc_your-api-key-here
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================
# Google Gemini AI ⭐ 100% FREE (for ALL AI features)
# ============================================
# Get your FREE API key from:
# https://aistudio.google.com/app/apikey
#
# Free tier: 1500 requests/day, 60 requests/minute
# No credit card required!
#
# Used for ALL AI features:
# - 🎯 AI Recommendations (personalized learning suggestions)
# - 💬 AI Tutor Chat (conversational pronunciation help)
# - 📊 Pronunciation Scoring (detailed feedback on attempts)
#
# The Gemini key is SERVER-SIDE ONLY. Do NOT give it a VITE_ prefix: any
# VITE_-prefixed variable is inlined into the client bundle and exposed to users.
# AI recommendations, tutor chat, and scoring are proxied through /api/* which
# read this key on the server. For Vercel, set GEMINI_API_KEY in the project env.
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# Azure AI Speech (for Premium TTS) ⭐ NEURAL VOICES
# ============================================
# Get these from your Azure AI Speech resource:
# https://portal.azure.com/
#
# These are SERVER-SIDE ONLY (not exposed to client)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=australiaeast

# Optional client-side informational region (not used for auth)
VITE_AZURE_SPEECH_REGION=australiaeast

# Client-side flag (optional) - Set to 'true' to enable premium TTS UI
# The API will still check server-side credentials regardless
VITE_PREMIUM_TTS_ENABLED=false

# ============================================
# Application Configuration
# ============================================
VITE_APP_VERSION=2.5.4
VITE_APP_NAME=PTE Pronunciation Trainer

# ============================================
# Development Settings
# ============================================
NODE_ENV=development
VITE_DEBUG=false
