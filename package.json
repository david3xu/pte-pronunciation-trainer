{
  "name": "pte-vocabulary-trainer",
  "version": "2.5.4",
  "description": "A web-based pronunciation training application for PTE vocabulary",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "python3 -m http.server 3001",
    "data": "npm run data:pte",
    "data:pte": "node scripts/pte-data-pipeline.js",
    "build": "node scripts/build.js",
    "build:ts": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:ts": "npm run build:ts && npm test",
    "lint": "npm run lint:js && npm run lint:ts",
    "lint:js": "eslint src/js/**/*.js",
    "lint:ts": "tsc --noEmit",
    "lint:css": "stylelint src/css/**/*.css",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.js",
    "validate:docs": "node scripts/validate-docs.js",
    "validate:structure": "node scripts/validate-structure.js",
    "validate:supabase": "node scripts/verify-supabase-setup.js",
    "validate:all": "npm run validate:docs && npm run validate:structure && npm run validate",
    "clean": "rm -rf dist/ data/processed/",
    "start": "npm run data:pte && npm run dev",
    "start:pte": "npm run data:pte && npm run dev",
    "deploy": "npm run deploy:pte",
    "deploy:pte": "npm run data:pte && npm run build && npm run validate:all",
    "vercel-build": "npm run vercel-build:pte",
    "vercel-build:pte": "npm run data:pte && npm run build",
    "prepare": "husky install"
  },
  "keywords": [
    "pronunciation",
    "vocabulary",
    "pte",
    "pte-fib-listening",
    "text-to-speech",
    "english",
    "ipa"
  ],
  "author": "CCL Pronunciation Trainer Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.10.0",
    "babel-jest": "^30.2.0",
    "cssnano": "^6.0.1",
    "eslint": "^8.45.0",
    "html-minifier": "^4.0.0",
    "husky": "^8.0.3",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "uglify-js": "^3.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ccl-pronunciation-trainer.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/ccl-pronunciation-trainer/issues"
  },
  "homepage": "https://github.com/your-username/ccl-pronunciation-trainer#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "Chrome >= 90",
    "Firefox >= 88",
    "Safari >= 14",
    "Edge >= 90"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/js/**/*.js",
      "!src/js/**/*.d.ts",
      "!src/js/**/*.d.ts.map",
      "!src/js/**/*.js.map",
      "!src/js/utils/EventBus.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(posthog-js)/)"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/tests/__mocks__/styleMock.js",
      "^.*/supabase/.*\\.js$": "<rootDir>/tests/__mocks__/supabaseServices.js"
    }
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "error",
      "no-console": "warn",
      "semi": [
        "error",
        "always"
      ]
    }
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "rules": {
      "indentation": 2,
      "string-quotes": "single"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "immer": "^10.2.0",
    "posthog-js": "^1.290.0",
    "zustand": "^5.0.8"
  }
}
