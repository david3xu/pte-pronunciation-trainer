# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# PostHog Analytics (Optional)
# ============================================
# Get these from your PostHog project:
# https://app.posthog.com/project/settings
VITE_POSTHOG_API_KEY=phc_your-api-key-here
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================
# Google Gemini AI ⭐ 100% FREE (for ALL AI features)
# ============================================
# Get your FREE API key from:
# https://aistudio.google.com/app/apikey
#
# Free tier: 1500 requests/day, 60 requests/minute
# No credit card required!
#
# Used for ALL AI features:
# - 🎯 AI Recommendations (personalized learning suggestions)
# - 💬 AI Tutor Chat (conversational pronunciation help)
# - 📊 Pronunciation Scoring (detailed feedback on attempts)
#
# NOTE: Use VITE_GEMINI_API_KEY for client-side, GEMINI_API_KEY for server-side
# For Vercel deployment, set GEMINI_API_KEY in environment variables
VITE_GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# AWS Polly (for Premium TTS) ⭐ NEURAL VOICES
# ============================================
# Get these from your AWS IAM console:
# https://console.aws.amazon.com/iam/
# Required IAM permissions: polly:SynthesizeSpeech
#
# Pricing: $16.00 per 1 million characters
# Free Tier: 1 million characters/month (first 12 months)
#
# These are SERVER-SIDE ONLY (not exposed to client)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Client-side flag (optional) - Set to 'true' to enable premium TTS UI
# The API will still check server-side credentials regardless
VITE_PREMIUM_TTS_ENABLED=false

# ============================================
# Application Configuration
# ============================================
VITE_APP_VERSION=2.5.4
VITE_APP_NAME=PTE Pronunciation Trainer

# ============================================
# Development Settings
# ============================================
NODE_ENV=development
VITE_DEBUG=false
