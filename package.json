{
  "name": "pte-vocabulary-trainer",
  "version": "3.0.2",
  "description": "A web-based pronunciation training application for PTE vocabulary",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "cap:sync:ios": "vite build && npx cap sync ios",
    "cap:sync:ios:prod": "VITE_API_BASE_URL=https://ccl-pronunciation-trainer.vercel.app vite build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "cap:run:ios": "npx cap run ios",
    "dev:proxy": "node scripts/dev-proxy.js",
    "preview": "vite preview",
    "data": "pnpm run data:pte",
    "data:pte": "node scripts/pte-data-pipeline.js",
    "build": "pnpm run compile:ts && pnpm run typecheck:api && vite build",
    "build:ts": "tsc --noEmit && pnpm run typecheck:api",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "compile:ts": "tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ts": "pnpm run build:ts && pnpm test",
    "lint": "pnpm run lint:ts",
    "lint:ts": "tsc --noEmit",
    "lint:css": "stylelint src/css/**/*.css",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.js",
    "validate:docs": "node scripts/validate-docs.js",
    "validate:structure": "node scripts/validate-structure.js",
    "validate:supabase": "node scripts/verify-supabase-setup.js",
    "validate:all": "pnpm run validate:docs && pnpm run validate:structure && pnpm run validate",
    "infra:azure:speech": "bash scripts/deploy-azure-speech.sh",
    "infra:azure:speech:deploy": "DEPLOY_VERCEL=true bash scripts/deploy-azure-speech.sh",
    "clean": "rm -rf dist/",
    "start": "pnpm run data:pte && pnpm run dev",
    "start:pte": "pnpm run data:pte && pnpm run dev",
    "deploy": "pnpm run deploy:pte",
    "deploy:pte": "pnpm run data:pte && pnpm run build && pnpm run validate:all",
    "vercel-build": "pnpm run vercel-build:pte",
    "vercel-build:pte": "pnpm run data:pte && vite build && mkdir -p dist/data && cp -r data/processed dist/data/",
    "prepare": "husky install"
  },
  "keywords": [
    "pronunciation",
    "vocabulary",
    "pte",
    "pte-fib-listening",
    "text-to-speech",
    "english",
    "ipa"
  ],
  "author": "CCL Pronunciation Trainer Team",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.61.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vercel/node": "^5.5.6",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "autoprefixer": "^10.4.21",
    "cssnano": "^6.0.1",
    "eslint": "^8.45.0",
    "happy-dom": "^20.0.10",
    "html-minifier": "^4.0.0",
    "husky": "^8.0.3",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "uglify-js": "^3.17.0",
    "vite": "7.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ccl-pronunciation-trainer.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/ccl-pronunciation-trainer/issues"
  },
  "homepage": "https://github.com/your-username/ccl-pronunciation-trainer#readme",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=10.0.0"
  },
  "browserslist": [
    "Chrome >= 90",
    "Firefox >= 88",
    "Safari >= 14",
    "Edge >= 90"
  ],
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "error",
      "no-console": "warn",
      "semi": [
        "error",
        "always"
      ]
    }
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "rules": {
      "indentation": 2,
      "string-quotes": "single"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@google/genai": "^1.29.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/themes": "^3.2.1",
    "@supabase/supabase-js": "^2.80.0",
    "dotenv": "^17.2.3",
    "http-proxy": "^1.18.1",
    "immer": "^10.2.0",
    "localforage": "^1.10.0",
    "openai": "^6.8.1",
    "posthog-js": "^1.290.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "packageManager": "pnpm@10.32.1"
}
