{
  "buildCommand": "npx tsc && cp -r dist/compiled/ts/* src/js/ && node scripts/add-js-extensions.js && node scripts/pte-data-pipeline.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/data/processed/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=60"
        }
      ]
    },
    {
      "source": "/src/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0"
        }
      ]
    }
  ]
}