{
  "name": "ccl-pronunciation-trainer",
  "version": "1.0.0",
  "description": "A web-based pronunciation training application for NAATI CCL exam preparation",
  "main": "index.html",
  "scripts": {
    "dev": "python3 -m http.server 3000",

    "data": "node scripts/unified-data-pipeline.js",
    "data:legacy": "npm run process-all-data",
    "data:resume": "node scripts/resume-data-pipeline.js",

    "extract-vocab": "node scripts/conversation-vocabulary-extractor.js",
    "process-data": "node scripts/process-dialogue-data.js",
    "generate-words-dataset": "node scripts/generate-words-dataset.js",
    "generate-vocabulary-data": "node scripts/generate-vocabulary-data.js",
    "generate-resume-terms-dataset": "node scripts/generate-resume-terms-dataset.js",
    "generate-all-datasets": "node scripts/generate-all-datasets.js",
    "process-all-data": "npm run process-data && npm run extract-vocab && node scripts/process-unfamiliar-words.js && npm run generate-all-datasets",

    "build": "node scripts/build.js",
    "test": "jest",
    "lint": "eslint src/js/**/*.js && stylelint src/css/**/*.css",
    "validate": "node scripts/validate.js",
    "clean": "rm -rf dist/ data/generated/ data/processed/",

    "start": "npm run data && npm run dev",
    "start:legacy": "npm run process-all-data && npm run dev",
    "start:resume": "npm run data:resume && npm run dev",

    "deploy": "npm run data && npm run build && npm run validate",
    "deploy:resume": "npm run data:resume && npm run build && npm run validate",
    "vercel-build": "npm run data && npm run build",
    "vercel-build:resume": "npm run data:resume && npm run build"
  },
  "keywords": [
    "ccl",
    "naati",
    "pronunciation",
    "vocabulary",
    "language-learning",
    "text-to-speech",
    "chinese",
    "english",
    "exam-preparation"
  ],
  "author": "CCL Pronunciation Trainer Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.45.0",
    "stylelint": "^15.10.0",
    "jest": "^29.6.0",
    "uglify-js": "^3.17.0",
    "cssnano": "^6.0.1",
    "html-minifier": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ccl-pronunciation-trainer.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/ccl-pronunciation-trainer/issues"
  },
  "homepage": "https://github.com/your-username/ccl-pronunciation-trainer#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "Chrome >= 90",
    "Firefox >= 88",
    "Safari >= 14",
    "Edge >= 90"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": ["eslint:recommended"],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "error",
      "no-console": "warn",
      "semi": ["error", "always"]
    }
  },
  "stylelint": {
    "extends": ["stylelint-config-standard"],
    "rules": {
      "indentation": 2,
      "string-quotes": "single"
    }
  }
}